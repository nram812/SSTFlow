#!/bin/bash
#PBS -N flow-cont-smoke
#PBS -q h200q
#PBS -l select=1:ncpus=8:mem=96GB:ngpus=1
#PBS -l walltime=01:00:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?submit this script from the project root}"
pixi run -e gpu python src/train_flow.py \
  --config configs/flow_sr_continue_220k.json --smoke-steps 120001 --device cuda
qsub jobs/train_flow_continue.pbs
