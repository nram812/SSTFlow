#!/bin/bash
#PBS -N sst-combined-infer
#PBS -q h200q
#PBS -l select=1:ncpus=16:mem=128GB:ngpus=1
#PBS -l walltime=12:00:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?submit this script from the project root}"
export PYTHONPATH="$PWD/src"
export MPLBACKEND=Agg

run=runs/flow_sr_combined_hist_rcp85_continue_320k
access_config=configs/access_cm2_inference_combined_hist_rcp85.json

test "$(pixi run python -c 'import json; print(json.load(open("runs/flow_sr_combined_hist_rcp85_continue_320k/status.json"))["status"])')" = passed
test -f "$run/model_ema.pt"

pixi run -e gpu python -u src/evaluate.py \
  --run "$run" \
  --device cuda \
  --all-samples \
  --batch-size 4 \
  --sampler ab3_pc \
  --sampler-steps 75 \
  --rollout-days 0

pixi run python -u src/validate_flow_inference.py \
  --run "$run" \
  --test-product "$run/evaluation/full_test_samples_ab3_pc_75step.nc"

pixi run -e gpu python -u src/infer_access_cm2.py \
  --config "$access_config" --period-name historical --device cuda
pixi run python -u src/validate_flow_inference.py \
  --run "$run" \
  --access-config "$access_config" --period-name historical

pixi run -e gpu python -u src/infer_access_cm2.py \
  --config "$access_config" --period-name future --device cuda
pixi run python -u src/validate_flow_inference.py \
  --run "$run" \
  --access-config "$access_config" --period-name future
