#!/bin/bash
#PBS -N sst-flow-ar-year-ab2pc75
#PBS -q h200q
#PBS -l select=1:ncpus=16:mem=128GB:ngpus=1
#PBS -l walltime=24:00:00
#PBS -j oe
set -euo pipefail

cd "${PBS_O_WORKDIR:?submit this script from the project root}"
export PYTHONPATH="$PWD/src"
export MPLBACKEND=Agg
export MPLCONFIGDIR="${TMPDIR:-/tmp}/matplotlib-flow-ar-production"
mkdir -p "$MPLCONFIGDIR"

OUTPUT=runs/flow_ar/evaluation/test_2011_free_rollout_ab2pc_75step.nc
test ! -e "$OUTPUT"

pixi run -e gpu python -u src/run_flow_ar_rollout.py \
  --run runs/flow_ar \
  --initial-date 2011-01-01 \
  --end-date 2011-12-31 \
  --output "$OUTPUT" \
  --sampler ab2_pc \
  --sampler-steps 75 \
  --seed 2020 \
  --device cuda

pixi run -e gpu python -u src/validate_flow_ar_rollout.py \
  --input "$OUTPUT" \
  --initial-date 2011-01-01 \
  --end-date 2011-12-31 \
  --sampler ab2_pc \
  --sampler-steps 75
