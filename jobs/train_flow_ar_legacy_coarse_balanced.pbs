#!/bin/bash
#PBS -N sst-flow-ar-mid
#PBS -q h200q
#PBS -l select=1:ncpus=16:mem=128GB:ngpus=1
#PBS -l walltime=24:00:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?submit this script from the project root}"
PYTHONPATH=src pixi run -e gpu python -u src/train_flow_ar.py \
  --config configs/flow_ar_legacy_coarse_balanced.json
status=$(pixi run python -c 'import json; print(json.load(open("runs/flow_ar_legacy_coarse_balanced/status.json"))["status"])')
if [[ "$status" == checkpointed ]]; then qsub jobs/train_flow_ar_legacy_coarse_balanced.pbs; fi
