#!/bin/bash
#PBS -N sst-flow-1000
#PBS -q h200q
#PBS -l select=1:ncpus=16:mem=128GB:ngpus=1
#PBS -l walltime=03:00:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?submit this script from the project root}"
export PYTHONPATH="$PWD/src"
export MPLBACKEND=Agg
started=$SECONDS
pixi run -e gpu python -u src/train_flow.py --config configs/flow_sr.json --smoke-steps 1000 --device cuda
pixi run -e gpu python -u src/check_conditioning.py --run runs/smoke/flow_sr --device cuda --steps 25 --weights model_ema.pt
echo "flow_1000_elapsed_seconds=$((SECONDS - started))"
