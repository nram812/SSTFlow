#!/bin/bash
#PBS -N flow-continue
#PBS -q h200q
#PBS -l select=1:ncpus=16:mem=128GB:ngpus=1
#PBS -l walltime=24:00:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?submit this script from the project root}"
pixi run -e gpu python src/train_flow.py --config configs/flow_sr_continue_220k.json
status=$(pixi run python -c 'import json; print(json.load(open("runs/flow_sr_continue_220k/status.json"))["status"])')
if [[ "$status" == checkpointed ]]; then qsub jobs/train_flow_continue.pbs; fi
