#!/bin/bash
#PBS -N srdn-eval
#PBS -q h200q
#PBS -l select=1:ncpus=16:mem=128GB:ngpus=1
#PBS -l walltime=24:00:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?submit from the SSTDownscaling root}"
PYBIN="${PYBIN:-$PWD/SRDN/venv_srdn_gpu/bin/python}"
if [[ ! -x "$PYBIN" ]]; then echo "Missing GPU Python: $PYBIN" >&2; exit 2; fi
export PYTHONPATH="$PWD/SRDN"
for MODEL in srdcnn resafno; do
  "$PYBIN" -u SRDN/evaluate_srdn.py \
    --run "runs/srdn_${MODEL}_mask_aware_f16" \
    --config "configs/srdn_${MODEL}.json" --batch-size 2
done
"$PYBIN" -u SRDN/compare_srdn.py \
  --resafno-run runs/srdn_resafno_mask_aware_f16 \
  --srdcnn-run runs/srdn_srdcnn_mask_aware_f16 \
  --output runs/srdn_comparison.json
