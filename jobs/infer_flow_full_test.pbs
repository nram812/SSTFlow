#!/bin/bash
#PBS -N sst-flow-infer
#PBS -q h200q
#PBS -l select=1:ncpus=16:mem=128GB:ngpus=1
#PBS -l walltime=06:00:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?submit this script from the project root}"
export PYTHONPATH="$PWD/src"
export MPLBACKEND=Agg

test "$(pixi run python -c 'import json; print(json.load(open("runs/flow_sr/status.json"))["status"])')" = passed
test -f runs/flow_sr/model_ema.pt

pixi run -e gpu python -u src/evaluate.py \
  --run runs/flow_sr \
  --device cuda \
  --all-samples \
  --batch-size 4 \
  --sampler-steps 50 \
  --rollout-days 0

pixi run -e gpu python - <<'PY'
import json
import numpy as np
import xarray as xr

product = "runs/flow_sr/evaluation/full_test_samples.nc"
metrics_path = "runs/flow_sr/evaluation/full_test_metrics.json"
with xr.open_dataset(product, engine="h5netcdf") as dataset:
    assert dataset.sizes["time"] == 1461, dataset.sizes
    assert set(dataset.data_vars) == {"sst_generated", "sst_target", "sst_coarse"}
    dates = dataset.time.values.astype("datetime64[D]")
    assert dates[0] == np.datetime64("2011-01-01")
    assert dates[-1] == np.datetime64("2014-12-31")
    assert np.all(np.diff(dates) == np.timedelta64(1, "D"))
    generated = dataset.sst_generated.isel(time=[0, -1]).values
    target = dataset.sst_target.isel(time=[0, -1]).values
    assert np.isfinite(generated[np.isfinite(target)]).all()
    assert dataset.attrs["selection"] == "full_test"
    assert dataset.attrs["sampler_steps"] == 50

with open(metrics_path) as handle:
    metrics = json.load(handle)
assert metrics["selection"] == "full_test"
assert metrics["samples"] == 1461
print(f"[ok] {product}: 1461 consecutive test days; metrics complete")
PY
