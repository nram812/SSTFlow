#!/bin/bash
#PBS -N sst-noaa-prep
#PBS -q shortq
#PBS -l select=1:ncpus=8:mem=64GB
#PBS -l walltime=02:00:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?submit this script from the project root}"
PYTHONPATH=src pixi run python -u src/preprocess_noaa_5km.py \
  --config configs/flow_sr_noaa_5km_frozen_trunk_1024.json --chunk 4
