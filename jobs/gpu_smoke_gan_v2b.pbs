#!/bin/bash
#PBS -N smoke-gan-v2b
#PBS -q h200q
#PBS -l select=1:ncpus=8:mem=64GB:ngpus=1
#PBS -l walltime=00:30:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?submit this script from the project root}"
pixi run -e gpu python -u src/train_gan.py \
  --config configs/gan_sr_v2b_image_only_critic.json \
  --smoke-steps 3 \
  --smoke-output-dir runs/gpu_smoke/gan_sr_v2b_image_only_critic \
  --device cuda
