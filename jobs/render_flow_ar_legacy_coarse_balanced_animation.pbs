#!/bin/bash
#PBS -N sst-ar-mid-anim
#PBS -q shortq
#PBS -l select=1:ncpus=8:mem=32GB
#PBS -l walltime=01:30:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?submit this script from the project root}"
export MPLBACKEND=Agg
export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4

PYTHON=.pixi/envs/default/bin/python
INPUT=runs/flow_ar_legacy_coarse_balanced/evaluation/test_2011_common_noise_free_rollout_ab2pc_75step.nc
COMMON=(
  --input "$INPUT"
  --model-label "Coarse-balanced legacy Flow-AR"
  --title "Coarse-Balanced Flow-AR SST Super-Resolution (2011 Free Rollout)"
  --layout-name flow_ar_legacy_coarse_balanced_animation_layout.png
)

test -f "$INPUT"
test -f "${INPUT%.nc}.validation.json"

$PYTHON -u figures/animate_flow_ar_sst.py "${COMMON[@]}" --layout-only --dpi 100
$PYTHON -u figures/animate_flow_ar_sst.py "${COMMON[@]}" \
  --output figures/flow_ar_legacy_coarse_balanced_sst_preview.gif \
  --fps 6 --stride 5 --max-frames 60 --dpi 60
$PYTHON -u figures/animate_flow_ar_sst.py "${COMMON[@]}" \
  --output figures/flow_ar_legacy_coarse_balanced_sst_comparison_300frames.mp4 \
  --fps 10 --stride 1 --max-frames 300 --dpi 90

test -s figures/flow_ar_legacy_coarse_balanced_sst_preview.gif
test -s figures/flow_ar_legacy_coarse_balanced_sst_comparison_300frames.mp4
