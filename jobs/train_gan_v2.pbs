#!/bin/bash
#PBS -N sst-gan-v2
#PBS -q h200q
#PBS -l select=1:ncpus=16:mem=128GB:ngpus=1
#PBS -l walltime=24:00:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?submit this script from the project root}"
pixi run -e gpu train-gan-v2
status=$(pixi run python -c 'import json; print(json.load(open("runs/gan_sr_v2/status.json"))["status"])')
if [[ "$status" == checkpointed ]]; then qsub jobs/train_gan_v2.pbs; fi
