#!/bin/bash
#PBS -N sst-ar-mid-report
#PBS -q shortq
#PBS -l select=1:ncpus=4:mem=64GB
#PBS -l walltime=02:00:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?submit this script from the project root}"
export PYTHONPATH="$PWD/src"
export MPLBACKEND=Agg
export MPLCONFIGDIR="${TMPDIR:-/tmp}/matplotlib-ar-mid-report"
mkdir -p "$MPLCONFIGDIR"
PRODUCT=runs/flow_ar_legacy_coarse_balanced/evaluation/test_2011_common_noise_free_rollout_ab2pc_75step.nc
test -f "$PRODUCT"
test -f "${PRODUCT%.nc}.validation.json"
pixi run python analysis/generate_extended_evaluation.py --allow-missing
pixi run python analysis/update_comparison_notebooks.py
pixi run python presentation/build_editable_sst_downscaling_deck.py
pixi run python -m pytest tests/test_extended_evaluation.py tests/test_editable_presentation.py -q
